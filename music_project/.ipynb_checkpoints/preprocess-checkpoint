    "ANNOTATION_FILE = r\"D:\\Study\\M.tech\\3rd Sem\\Project Phase-2\\project\\Annotations.txt\"\n",
    "VIDEO_DIR = r\"D:\\Study\\M.tech\\3rd Sem\\Project Phase-2\\ave\"\n",
    "FRAME_DIR = \"project/frames\"\n",
    "DATASET_JSON_PATH = \"project/dataset.json\"\n",
    "FRAMES_PER_VIDEO = 16\n",
    "RESOLUTION = (256, 256)\n",
    "BATCH_SIZE = 32\n",
    "SKIP_EXISTING = True\n",
    "\n",
    "\n",
    "def load_annotations_txt():\n",
    "    annotations = {}\n",
    "    with open(ANNOTATION_FILE, \"r\") as f:\n",
    "        next(f)  # skip header\n",
    "        for line in f:\n",
    "            fields = line.strip().split(\"&\")\n",
    "            if len(fields) != 5:\n",
    "                continue\n",
    "            categories_raw, video_id, quality, start, end = fields\n",
    "            category_list = [cat.strip() for cat in categories_raw.split(\",\")]\n",
    "            annotations[video_id] = {\n",
    "                \"categories\": category_list,\n",
    "                \"start\": float(start),\n",
    "                \"end\": float(end)\n",
    "            }\n",
    "    return annotations\n",
    "\n",
    "def extract_frames_ffmpeg(video_path, output_dir, num_frames=16, resolution=(256, 256)):\n",
    "    os.makedirs(output_dir, exist_ok=True)\n",
    "\n",
    "    # 1. Get video duration using ffprobe\n",
    "    try:\n",
    "        result = subprocess.run(\n",
    "            [\n",
    "                \"ffprobe\", \"-v\", \"error\", \"-select_streams\", \"v:0\",\n",
    "                \"-show_entries\", \"stream=nb_frames,duration\",\n",
    "                \"-of\", \"default=noprint_wrappers=1:nokey=1\", video_path\n",
    "            ],\n",
    "            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True\n",
    "        )\n",
    "        output_lines = result.stdout.strip().split(\"\\n\")\n",
    "        duration = float(output_lines[-1])  # Use duration in seconds\n",
    "    except:\n",
    "        print(f\"❌ Failed to probe {video_path}\")\n",
    "        return []\n",
    "\n",
    "    # 2. Sample timestamps uniformly\n",
    "    timestamps = [duration * i / num_frames for i in range(num_frames)]\n",
    "\n",
    "    # 3. Extract frame at each timestamp\n",
    "    frame_paths = []\n",
    "    for idx, t in enumerate(timestamps):\n",
    "        out_path = os.path.join(output_dir, f\"{idx:04d}.jpg\")\n",
    "        cmd = [\n",
    "            \"ffmpeg\", \"-y\", \"-ss\", str(t), \"-i\", video_path,\n",
    "            \"-frames:v\", \"1\",\n",
    "            \"-vf\", f\"scale={resolution[0]}:{resolution[1]}\",\n",
    "            out_path\n",
    "        ]\n",
    "        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\n",
    "        frame_paths.append(out_path)\n",
    "\n",
    "    return frame_paths\n",
    "\n",
    "def process_batch(video_ids, annotations, dataset):\n",
    "    for video_id in tqdm(video_ids, desc=\"Batch\"):\n",
    "        data = annotations[video_id]\n",
    "        video_path = os.path.join(VIDEO_DIR, f\"{video_id}.mp4\")\n",
    "        frame_dir = os.path.join(FRAME_DIR, video_id)\n",
    "\n",
    "        if not os.path.exists(video_path):\n",
    "            print(f\"⚠️ Video missing: {video_id}\")\n",
    "            continue\n",
    "\n",
    "        if SKIP_EXISTING and os.path.isdir(frame_dir):\n",
    "            frame_files = sorted([f for f in os.listdir(frame_dir) if f.endswith(\".jpg\")])\n",
    "            if len(frame_files) >= FRAMES_PER_VIDEO:\n",
    "                dataset[video_id] = {\n",
    "                    \"categories\": data[\"categories\"],\n",
    "                    \"video_path\": video_path,\n",
    "                    \"frame_paths\": [os.path.join(frame_dir, f) for f in frame_files[:FRAMES_PER_VIDEO]],\n",
    "                    \"audio_feature_path\": f\"audio_features/{video_id}.npy\",\n",
    "                    \"text_feature_path\": f\"text_features/{video_id}.npy\"\n",
    "                }\n",
    "                continue\n",
    "\n",
    "        frame_paths = extract_frames_ffmpeg(\n",
    "            video_path, frame_dir,\n",
    "            num_frames=FRAMES_PER_VIDEO,\n",
    "            resolution=RESOLUTION\n",
    "        )\n",
    "\n",
    "        dataset[video_id] = {\n",
    "            \"categories\": data[\"categories\"],\n",
    "            \"video_path\": video_path,\n",
    "            \"frame_paths\": frame_paths,\n",
    "            \"audio_feature_path\": f\"audio_features/{video_id}.npy\",\n",
    "            \"text_feature_path\": f\"text_features/{video_id}.npy\"\n",
    "        }\n",
    "\n",
    "def main():\n",
    "    annotations = load_annotations_txt()\n",
    "    dataset = {}\n",
    "\n",
    "    video_ids = list(annotations.keys())\n",
    "\n",
    "    for i in range(0, len(video_ids), BATCH_SIZE):\n",
    "        batch = video_ids[i:i + BATCH_SIZE]\n",
    "        process_batch(batch, annotations, dataset)\n",
    "\n",
    "        # Optional save after each batch\n",
    "        with open(DATASET_JSON, \"w\") as f:\n",
    "            json.dump(dataset, f, indent=2)\n",
    "\n",
    "    print(f\"\\n✅ Done. dataset.json saved with {len(dataset)} entries.\")\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    main()\n"
   ]
